// BoardConfig.spt — SpiderLang for Android Recovery (Native, no mk)
// Replaces BoardConfig.mk with a modern language
// Target: device/infinix/X6886 — TWRP
// This file is the source of truth — spider builds directly from it, no mk conversion

board {
    arch: "arm64",
    arch_variant: "armv8-a",
    cpu_abi: "arm64-v8a",
    cpu_variant: "cortex-a55",

    bootloader: {
        board_name: "X6886",
        kernel_pagesize: 4096,
        boot_partition_size: 64.MB,
        // Also valid: 65536.KB or 67108864.B or 0.0625.GB — all equal, typed
        recovery_partition_size: 64.MB,
        vendor_boot_size: 32.MB,
        super_partition_size: 9128.MB
    },

    kernel: {
        base: "0x40078000",
        cmdline: "bootopt=64S3,32N2,64N2 androidboot.selinux=permissive",
        image_name: "Image.gz",
        separated_dtbo: true,
        include_dtbo: true,
        header_version: 2
    },

    recovery: {
        type: "twrp",
        theme: "portrait_hdpi",
        pixel_format: "RGBX_8888",
        include_crypto: true,
        include_crypto_fbe: true,
        exclude_apex: true,
        has_mtp: true,
        brightness_path: "/sys/class/leds/lcd-backlight/brightness",
        max_brightness: 255,
        default_language: "en",
        extra_languages: true,
        use_toolbox: true,
        include_ntfs_3g: true,
        // All TWRP flags as a list — easy to extend
        flags: ["TW_EXCLUDE_APEX", "TW_HAS_MTP", "TW_BRIGHTNESS_PATH", "TW_INCLUDE_NTFS_3G", "TW_EXTRA_LANGUAGES"]
    },

    partitions: {
        has_large_filesystem: true,
        system_type: "ext4",
        vendor_type: "ext4",
        userdata_fs: "f2fs",
        use_f2fs: true,
        use_ext4: true
    },

    avb: {
        enable: true,
        rollback_index: 0
    },

    security: {
        platform_version: "14.0.0",
        platform_patch: "2127-12-31",
        vendor_patch: "2127-12-31"
    }
}

// Universal FFI — call any language natively
use cpp "../validators/partition_check.cpp" as checker

print("Board arch is {board.arch}")
print("Boot size is {board.bootloader.boot_partition_size}")
print("Size in KB: {board.bootloader.boot_partition_size.to('KB')}")
print("Size in GB: {board.bootloader.boot_partition_size.to('GB')}")

// Verify via C++ validator (native, not mock)
checker.verify_sizes(board.bootloader)

// Validation logic — fails build if wrong
if board.bootloader.boot_partition_size == 64.MB {
    print("✓ Boot partition correctly set to 64.MB")
}
if board.bootloader.boot_partition_size == 65536.KB {
    print("✓ Also equals 65536.KB — conversion works!")
}
if board.bootloader.boot_partition_size == 67108864.B {
    print("✓ Also equals 67108864.B — all units unified!")
}
if board.bootloader.boot_partition_size == 0.0625.GB {
    print("✓ Also equals 0.0625.GB — GB conversion works!")
}

// Demonstrate size math
let total = board.bootloader.boot_partition_size + board.bootloader.vendor_boot_size
print("Total boot+vendor: {total} = {total.to('MB')} MB")

let nums = [1, 2, 3, 4]
let doubled = nums.map(x => x * 2)
print(doubled)
