// hello.spt — SpiderLang Example
let name = "Beru"
print("Hello {name} 🔥")

func factorial(n) {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}
print(factorial(5))  // 120

let nums = [1, 2, 3, 4]
let doubled = nums.map(x => x * 2)
print(doubled) // [2, 4, 6, 8]

// Size units — the core feature: 64.MB == 65536.KB
let a = 64.MB
let b = 65536.KB
let c = 67108864.B
print(a) // 64.MB (67108864 B)
print(b) // 65536.KB (67108864 B)
print(a == b) // true
print(a == c) // true
print(a.to("GB")) // 0.0625

// All units
print(1.KB)  // 1024 B
print(1.MB)  // 1048576 B
print(1.GB)  // 1073741824 B
print(1.TB)  // 1099511627776 B
print(1.PB)  // huge
