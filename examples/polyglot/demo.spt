use swift "../../ffi_examples/Engine.swift" as seng
use ruby "../../ffi_examples/script.rb" as rbscript
use php "../../ffi_examples/api.php" as phpapi
use lua "../../ffi_examples/config.lua" as luacfg
use dart "../../ffi_examples/ui.dart" as dartui
use csharp "../../ffi_examples/Utils.cs" as csutils
use haskell "../../ffi_examples/Algo.hs" as halgo
use zig "../../ffi_examples/math.zig" as zmath
use typescript "../../ffi_examples/app.ts" as tsapp
use shell "../../ffi_examples/helper.sh" as shhelper
use perl "../../ffi_examples/script.pl" as plscript
use r "../../ffi_examples/analysis.R" as rana
print("SpiderLang polyglot hub: 16 languages linked via FFI — all linked")
