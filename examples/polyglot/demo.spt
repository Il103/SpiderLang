// demo.spt — 15+ languages talking via SpiderLang hub, all linked
board {
    arch: "arm64",
    bootloader: { board_name: "X6886", kernel_pagesize: 4096, boot_partition_size: 64.MB }
}
use rust "../../ffi_examples/crypto.rs" as crypto
use go "../../ffi_examples/server.go" as srv
use java "../../ffi_examples/Helper.java" as jhelper
