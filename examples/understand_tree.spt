// examples/understand_tree.spt
// The language reads any Android device tree BY ITSELF — no scripts.
// understand() is a built-in part of the SpiderLang core.

let tree = understand("../device/infinix/X6886")

print("== Tree understood by SpiderLang ==")
print("codename : {tree.codename}")
print("recovery : {tree.recoveries}")
print("partitions found: {len(tree.partitions)}")

// read any file in the tree natively
print("BoardConfig lines: {len(readlines('../device/infinix/X6886/BoardConfig.spt'))}")

// list the tree directory with first-class I/O
let files = listdir("../device/infinix/X6886")
print("files in tree  : {len(files)}")
print(files)
